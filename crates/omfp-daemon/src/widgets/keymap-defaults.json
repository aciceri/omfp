    {
      "id": "thread.compact",
      "title": "Compact the context (:compact [soft|remote|snapcompact] [focus of the summary])",
      "aliases": [
        "compact"
      ],
      "description": "Has omp summarize the selected thread's conversation so far and continue from the summary, freeing context. Words after :compact tell the summary what to focus on; a first word soft, remote or snapcompact picks omp's method for this once (snapcompact takes no focus). Refused while the thread works; the transcript shows the compaction as a notice."
    },
    {
      "id": "thread.copy",
      "title": "Copy the conversation as Markdown (the focused message only, in the transcript)",
      "aliases": [
        "copy"
      ],
      "description": "Copies the selected thread's conversation to the clipboard as Markdown: messages under their author, tool calls as a line with their result, thinking left out, images as placeholders. With a message of the transcript focused (j and k move between them), only that message."
    },
