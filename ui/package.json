{
  "name": "omfp-web",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "tsc --noEmit -p .",
    "test": "bun run test:plain && bun run test:dom",
    "test:plain": "bun test packages/protocol packages/core packages/client",
    "test:dom": "bun test --preload ./test/dom.ts packages/kit packages/app packages/site",
    "build": "bun run --cwd packages/app build",
    "build:site": "bun run --cwd packages/site build"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
